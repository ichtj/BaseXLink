<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BaseXLinkLabel">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/label_text_size</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="BaseXLinkHint" parent="BaseXLinkLabel">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/hint_text_size</item>
        <item name="android:maxLines">2</item>
    </style>

    <style name="BaseXLinkInput">
        <item name="android:background">@android:drawable/edit_text</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/label_text_size</item>
    </style>

    <style name="BaseXLinkButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">@dimen/button_text_size</item>
    </style>

    <style name="BaseXLinkButtonRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/item_gap</item>
        <item name="android:baselineAligned">false</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="BaseXLinkGridButton" parent="BaseXLinkButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/control_height</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="BaseXLinkCompactButton" parent="BaseXLinkButton">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">@dimen/control_height</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
    </style>
</resources>
