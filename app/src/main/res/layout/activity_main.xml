<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding"
    tools:context="com.zgkx.change.MainAty">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="@dimen/panel_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSn"
                style="@style/BaseXLinkLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前SN:" />

            <EditText
                android:id="@+id/etSn"
                style="@style/BaseXLinkInput"
                android:layout_width="0dp"
                android:layout_height="@dimen/control_height"
                android:layout_marginStart="@dimen/item_gap"
                android:layout_weight="1"
                android:hint="请输入SN"
                android:inputType="textNoSuggestions"
                android:singleLine="true"
                android:text="FS240125X000121" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvConnStatus"
                style="@style/BaseXLinkLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="连接状态:false" />

            <Button
                android:id="@+id/btnClearMQttCache"
                style="@style/BaseXLinkButton"
                android:layout_width="@dimen/secondary_button_width"
                android:layout_height="@dimen/control_height"
                android:layout_marginStart="@dimen/item_gap"
                android:text="清MQTT缓存" />
            <Button
                android:id="@+id/btnReboot"
                style="@style/BaseXLinkCompactButton"
                android:text="重启" />
        </LinearLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_gap"
        android:background="@drawable/bg_panel"
        android:fillViewport="true"
        android:padding="@dimen/panel_padding"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAddDev"
                style="@style/BaseXLinkCompactButton"
                android:text="添加设备" />

            <Button
                android:id="@+id/btnGetDevice"
                style="@style/BaseXLinkCompactButton"
                android:text="设备信息" />

            <Button
                android:id="@+id/btnGetAgent"
                style="@style/BaseXLinkCompactButton"
                android:text="代理地址" />

            <Button
                android:id="@+id/btnConn"
                style="@style/BaseXLinkCompactButton"
                android:text="连接" />

            <Button
                android:id="@+id/btnSeHearbeat"
                style="@style/BaseXLinkCompactButton"
                android:text="心跳" />

            <Button
                android:id="@+id/btnDisConn"
                style="@style/BaseXLinkCompactButton"
                android:text="断开" />

            <Button
                android:id="@+id/btnAutoConn"
                style="@style/BaseXLinkCompactButton"
                android:text="自启:false" />

            <Button
                android:id="@+id/btnReboot"
                style="@style/BaseXLinkCompactButton"
                android:text="重启" />

            <Button
                android:id="@+id/btnUninit"
                style="@style/BaseXLinkCompactButton"
                android:text="解绑" />

            <Button
                android:id="@+id/btnPushEvent"
                style="@style/BaseXLinkCompactButton"
                android:text="发事件" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_gap"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTile"
            style="@style/BaseXLinkHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="操作响应日志" />

        <Button
            android:id="@+id/btnClear"
            style="@style/BaseXLinkButton"
            android:layout_width="@dimen/secondary_button_width"
            android:layout_height="@dimen/control_height"
            android:layout_marginStart="@dimen/item_gap"
            android:text="清除日志" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/item_gap"
        android:layout_weight="1"
        android:background="@drawable/ic_result__bg"
        android:fadeScrollbars="false"
        android:fontFamily="monospace"
        android:minHeight="0dp"
        android:overScrollMode="ifContentScrolls"
        android:padding="@dimen/log_padding"
        android:scrollbars="vertical"
        android:textColor="@color/log_text"
        android:textSize="@dimen/log_text_size" />

</LinearLayout>
